# Copie para .env e preencha. Nunca versione o .env.
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Onde o portal escuta: 127.0.0.1 = só neste computador; 0.0.0.0 = outros computadores da rede local
# (nesse caso inclua o IP da máquina em DJANGO_ALLOWED_HOSTS, ex.: localhost,127.0.0.1,192.168.0.10)
PORTAL_BIND=127.0.0.1
# Em acesso remoto por HTTPS atrás de proxy, defina DJANGO_HTTPS=true e DJANGO_CSRF_TRUSTED_ORIGINS=https://seu-dominio
DJANGO_HTTPS=false
DJANGO_CSRF_TRUSTED_ORIGINS=

# Banco (o Compose usa estes valores para criar o serviço db)
POSTGRES_DB=portal_acoes
POSTGRES_USER=portal
POSTGRES_PASSWORD=troque-esta-senha
DATABASE_URL=postgres://portal:troque-esta-senha@db:5432/portal_acoes

# Portal
PORTAL_NOME=Portal de Ações
# true = dados sintéticos rotulados "DEMONSTRAÇÃO"; false exige fontes homologadas (E8)
PORTAL_MODO_DEMO=true
LOG_LEVEL=INFO

# Chaves de fontes de dados (E3+). Deixe vazias no modo demo.
TWELVEDATA_API_KEY=
AWESOMEAPI_API_KEY=
BRAPI_API_KEY=
COINGECKO_API_KEY=
# Inteligência de mercado (opcionais, gratuitas): analistas, notícias, resultados, fundamentos. Ver docs/mercado.md.
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=
# Cotações das ações dos EUA da carteira: intervalo em minutos (Twelve Data grátis aguenta 5 min com até ~5 ações)
ACOES_EUA_INTERVALO_MIN=15
# Fonte das cotações dos EUA: twelvedata (padrão) ou finnhub (usa FINNHUB_API_KEY; até 50 consultas/min)
FONTE_COTACAO_EUA=twelvedata
# brapi (B3): token gratuito em brapi.dev em BRAPI_API_KEY; ações por requisição e intervalo conforme o plano
# Gratuito: 1 e 30 · Startup: 10 e 15 · Pro: 20 e 5
BRAPI_SIMBOLOS_POR_REQUISICAO=1
BRAPI_INTERVALO_MIN=30
# false desliga as rotinas do menu Mercado no coletor (candles de 1 ano, rodízio do universo, analistas, Focus)
PORTAL_COLETA_MERCADO=true

# Avisos de alertas fora do portal (vazio = canal desligado). Ver docs/alertas.md.
TELEGRAM_BOT_TOKEN=
TELEGRAM_GRUPO_CHAT_ID=
TELEGRAM_CHAT_ID=
# Token do feed usado pelo script de notificação do macOS (scripts/mac/instalar.sh). Gere algo longo e aleatório.
PORTAL_FEED_TOKEN=
# Endereço do portal nos links das mensagens
PORTAL_URL=http://127.0.0.1:8000
# Horários (São Paulo) do resumo diário da carteira pelos canais acima; vazio desliga
RESUMO_HORARIOS=08:00,18:30

# Backup automático (serviço "backup" do Compose): hora local, quantidade mantida, gerar um ao subir
BACKUP_HORA=03:00
BACKUP_RETENCAO=7
BACKUP_AO_INICIAR=false

# Assistente de IA (opcional). Sem chave, o assistente fica desligado e o restante do portal funciona.
PORTAL_AI_ENABLED=false
PORTAL_AI_PROVIDER=openai
PORTAL_AI_MODEL=
OPENAI_API_KEY=
PORTAL_GEMINI_ENABLED=false
PORTAL_GEMINI_FREE_TIER_CONFIRMED=false
GEMINI_API_KEY=
PORTAL_OLLAMA_ENABLED=false
PORTAL_OLLAMA_URL=http://localhost:11434
PORTAL_OLLAMA_MODEL=

# Cotações em tempo real (dados públicos; nenhuma chave de negociação)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
PORTAL_CRYPTO_STREAM=false

# Notícias
NOTICIAS_INTERVALO_MIN=
NOTICIAS_MODELO_TRADUCAO=

# Web Push (gere suas chaves com: python manage.py chave_notificacoes)
PORTAL_VAPID_PUBLIC_KEY=
PORTAL_VAPID_PRIVATE_KEY=
PORTAL_VAPID_SUBJECT=mailto:voce@example.com
